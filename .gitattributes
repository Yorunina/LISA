# Normalize text for Windows development and Linux deployment.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Preserve binary assets byte-for-byte.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.zip binary
