# Run: .venv\Scripts\python.exe scripts\dev_env.py init
# Real credentials are generated locally and must never enter Git.
LISA_DB_HOST=127.0.0.1
LISA_DB_PORT=55432
LISA_DB_NAME=lisa
LISA_DB_USER=lisa
LISA_DB_PASSWORD=generated-by-init
LISA_DB_ADMIN_PASSWORD=generated-by-init
LISA_ONEBOT_WS_URL=ws://127.0.0.1:3001
LISA_ONEBOT_TOKEN=generated-by-init
LISA_NAPCAT_WEBUI_TOKEN=generated-by-init
# Optional: QQ account to select for quick login after the initial QR login.
LISA_QQ_ACCOUNT=

# Application session and local web entry. Enable secure cookies behind HTTPS.
LISA_SESSION_DAYS=14
LISA_COOKIE_SECURE=false
LISA_WEB_URL=http://127.0.0.1:8000
# Test-mode recipient only. Normal private chat uses each account's verified QQ binding.
LISA_QQ_TEST_USER=

# Development-only candidate relay and model; keep the real key in local .env.
LISA_MODEL_BASE_URL=https://test.mcii.cc/v1
LISA_MODEL_API_KEY=
LISA_MODEL_NAME=gpt-6-astra
# USD estimates, not confirmed provider prices or the D09 public-trial budget.
# Daily accounting currently resets at 00:00 UTC.
LISA_MODEL_DAILY_USD=0.50
LISA_MODEL_TASK_USD=0.15
LISA_MODEL_INPUT_PER_MILLION=10
LISA_MODEL_OUTPUT_PER_MILLION=50
LISA_MODEL_MAX_OUTPUT_TOKENS=600
LISA_MODEL_CONCURRENCY=1
LISA_MODEL_TIMEOUT_SECONDS=60
# Optional embeddings reuse the endpoint/key and share all model budget/concurrency limits.
# Empty model disables retrieval indexing. Replace zero with the provider's input USD / 1M tokens.
LISA_EMBEDDING_MODEL=
LISA_EMBEDDING_DIMENSIONS=1536
LISA_EMBEDDING_INPUT_PER_MILLION=0
# One finite writing result; shares the same daily/task budget above.
LISA_WRITING_MAX_CHARS=600
LISA_WRITING_OUTPUT_TOKENS=1200
# Enable normal private messages after model configuration and account initialization.
LISA_CHAT_ENABLED=false
# Separate test mode: --allow-qq limits sender/recipient and requires 测试对话 <message>.
LISA_CHAT_TEST_ENABLED=false
# Delayed autonomous scenes are opt-in; these are initial pacing limits for trials.
LISA_AUTONOMY_ENABLED=false
# Proactive QQ contact requires this switch and each user's explicit contact setting.
LISA_PROACTIVE_ENABLED=false
LISA_AUTONOMOUS_SCENE_INTERVAL_MINUTES=120
LISA_AUTONOMOUS_SCENE_LIMIT=2
