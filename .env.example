# Run: runtime\venv\Scripts\python.exe scripts\dev_env.py init (writes runtime/.env)
# Real credentials are generated locally and must never enter Git.
LISA_DB_HOST=127.0.0.1
LISA_DB_PORT=55432
LISA_DB_NAME=lisa
LISA_DB_USER=lisa
LISA_DB_PASSWORD=generated-by-init
LISA_DB_ADMIN_PASSWORD=generated-by-init
LISA_ONEBOT_WS_URL=ws://127.0.0.1:3001
LISA_ONEBOT_TOKEN=generated-by-init
LISA_NAPCAT_WEBUI_TOKEN=generated-by-init
# Optional: QQ account to select for quick login after the initial QR login.
LISA_QQ_ACCOUNT=

# Application session and local web entry. Enable secure cookies behind HTTPS.
LISA_SESSION_DAYS=14
LISA_COOKIE_SECURE=false
# 网页及公开作品链接的外部访问地址；部署后改为手机/其他读者可访问的 HTTP(S) 地址。
LISA_WEB_URL=http://127.0.0.1:8000
# Test-mode recipient only. Normal private chat uses each account's verified QQ binding.
LISA_QQ_TEST_USER=

# Development-only candidate relay and model; keep the real key in local .env.
LISA_MODEL_BASE_URL=https://test.mcii.cc/v1
LISA_MODEL_API_KEY=
LISA_MODEL_NAME=gpt-6.1-sol
# CNY estimates; legacy *_USD names are retained. No currency conversion.
# Daily accounting currently resets at 00:00 UTC.
LISA_MODEL_DAILY_USD=10.00
LISA_MODEL_TASK_USD=0.15
LISA_MODEL_INPUT_PER_MILLION=2
LISA_MODEL_OUTPUT_PER_MILLION=10
# Application input cap in serialized UTF-8 bytes; verify the relay before raising it.
LISA_MODEL_MAX_INPUT_BYTES=64000
LISA_MODEL_MAX_OUTPUT_TOKENS=600
LISA_MODEL_CONCURRENCY=1
LISA_MODEL_TIMEOUT_SECONDS=120
# Independent private image generation and drawing descriptions have no consumption quotas.
# Keep its key separate from text/vision. These values alone do not start image calls.
LISA_IMAGE_BASE_URL=https://drc.totokens.cc/v1
LISA_IMAGE_API_KEY=
LISA_IMAGE_MODEL=gpt-image-2
LISA_IMAGE_TIMEOUT_SECONDS=180
# Optional embeddings share all model budget/concurrency limits.
# Set BOTH fields for a separate provider; leave BOTH empty to reuse the chat endpoint/key.
LISA_EMBEDDING_BASE_URL=
LISA_EMBEDDING_API_KEY=
# Empty model disables indexing. Price is input CNY / 1M tokens (Bailian v4 Beijing: 0.5).
LISA_EMBEDDING_MODEL=
LISA_EMBEDDING_DIMENSIONS=1536
# Provider input-list limit (text-embedding-v4: 10).
LISA_EMBEDDING_BATCH_SIZE=32
LISA_EMBEDDING_INPUT_PER_MILLION=0
# Optional text descriptions of QQ images; blank model disables visual understanding.
# Separate OpenAI-compatible chat/completions connection, sharing the chat task budget.
LISA_VISION_MODEL=
LISA_VISION_BASE_URL=
LISA_VISION_API_KEY=
# Input/output CNY per million tokens (qwen3.8-flash Beijing: 0.8 / 2.7).
LISA_VISION_INPUT_PER_MILLION=0
LISA_VISION_OUTPUT_PER_MILLION=0
# One finite writing result; shares the same daily/task budget above.
LISA_WRITING_MAX_CHARS=600
LISA_WRITING_OUTPUT_TOKENS=1200
# Temporary corpus and bounded style analysis; all calls share MODEL_* CNY limits above.
# Uploads are temporary, including decoded text; terminal tasks clear their source immediately.
LISA_STYLE_MAX_FILES=16
LISA_STYLE_MAX_UPLOAD_BYTES=8388608
LISA_STYLE_CORPUS_TTL_HOURS=24
# Distillation shares the daily allowance; MODEL_TASK_USD still caps chat/writing/trials.
LISA_STYLE_DISTILLATION_MAX_CALLS=28
LISA_STYLE_DISTILLATION_CHUNK_BYTES=24000
LISA_STYLE_DISTILLATION_MAX_INPUT_BYTES=64000
LISA_STYLE_DISTILLATION_OUTPUT_TOKENS=1600
# Target-centred TXT windows. Counts bound retrieval; they do not prove complete context.
LISA_STYLE_CHAT_CONTEXT_BEFORE=4
LISA_STYLE_CHAT_CONTEXT_AFTER=2
LISA_STYLE_CHAT_MAX_WINDOWS=24
# Enable normal private messages after model configuration and account initialization.
LISA_CHAT_ENABLED=false
# Separate test mode: --allow-qq limits sender/recipient and requires 测试对话 <message>.
LISA_CHAT_TEST_ENABLED=false
# Delayed autonomous scenes are enabled by default; set false to disable delayed plans.
LISA_AUTONOMY_ENABLED=true
# Proactive QQ contact is available by default; each user must still allow contact.
LISA_PROACTIVE_ENABLED=true
# Shared knowledge: one daily source snapshot; maintenance is included in the 10 CNY total.
LISA_SHARED_DAILY_USD=1.00
# Asia/Shanghai hour; the worker checks every ten minutes and catches up once.
LISA_AUTONOMOUS_SCENE_INTERVAL_MINUTES=120
LISA_AUTONOMOUS_SCENE_LIMIT=2
