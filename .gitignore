# Project documents and prototype live in /.docs/ and are versioned.
# Do not blanket-ignore dot directories, Markdown, manifests or lockfiles.

# Local credentials; commit only templates containing placeholder values.
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.*.sample
/secrets/
/credentials/
*.key
*.pem
*.p12
*.pfx

# Machine-local environment/package-manager configuration and shell history.
# Keep version pins, dependency manifests, lockfiles and setup scripts versioned.
/.envrc
/.direnv/
/.npmrc
/.pypirc
/pip.ini
/.python_history
/.node_repl_history

# Local environment, caches, builds, reports and persistent runtime data live here.
# Never delete runtime/ wholesale: it also holds the database and QQ configuration.
/data/
/runtime/
/storage/
/pgdata/
/volumes/
/backups/
/exports/
/indexes/
/logs/
*.log
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# Python dependencies, bytecode, packaging and tool caches.
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
pytest-cache-files-*/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml

# React / TypeScript / Vite dependencies and generated output.
node_modules/
.vite/
*.tsbuildinfo
/build/
/dist/
/coverage/
/playwright-report/
/test-results/
/test-results-*/
/blob-report/

# Project-local package/tool caches (runtime/ also contains persistent data).
/.cache/
/.npm/
/.uv-cache/

# Machine-specific editor / agent settings and temporary files.
/.idea/
/.vscode/
/.vs/
/.codex/
/.agents/
AGENTS.md
AGENTS.override.md
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
*.tmp
*.temp
# Patch/merge leftovers; source patches themselves remain versioned.
*.orig
*.rej
/tmp/
/temp/
